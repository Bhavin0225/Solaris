          "model": {
            "title": "Model",
            "type": "string"
          },
          "n": {
            "title": "N",
            "type": "integer"
          },
          "observed_cf": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observed Cf"
          },
          "predicted_cf": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Predicted Cf"
          },
          "rmse_cf": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rmse Cf"
          },
          "season": {
            "title": "Season",
            "type": "string"
          }
        },
        "required": [
          "season",
          "model",
          "n",
          "observed_cf",
          "predicted_cf",
          "rmse_cf"
        ],
        "title": "WindCfRow",
        "type": "object"
      },
      "WindCfg": {
        "additionalProperties": false,
        "properties": {
          "availability_loss": {
            "exclusiveMaximum": 1.0,
            "minimum": 0.0,
            "title": "Availability Loss",
            "type": "number"
          },
          "cut_in_ms": {
            "title": "Cut In Ms",
            "type": "number"
          },
          "cut_out_ms": {
            "title": "Cut Out Ms",
            "type": "number"
          },
          "hub_height_m": {
            "exclusiveMinimum": 0.0,
            "title": "Hub Height M",
            "type": "number"
          },
          "power_curve_csv": {
            "pattern": "^[A-Za-z0-9_.-]+\\.csv$",
            "title": "Power Curve Csv",
            "type": "string"
          },
          "rated_kw": {
            "exclusiveMinimum": 0.0,
            "title": "Rated Kw",
            "type": "number"
          },
          "rated_ms": {
            "title": "Rated Ms",
            "type": "number"
          }
        },
        "required": [
          "rated_kw",
          "hub_height_m",
          "availability_loss",
          "cut_in_ms",
          "rated_ms",
          "cut_out_ms",
          "power_curve_csv"
        ],
        "title": "WindCfg",
        "type": "object"
      }
    }
  },
